[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[alias]
	br = branch
	ch = checkout
	c = commit
	p = push
	r = restore .
	l = log --oneline -n 10
[user]
	name = akv
	email = whoiscyberial@gmail.com
[push]
	default = simple
	autoSetupRemote = true
