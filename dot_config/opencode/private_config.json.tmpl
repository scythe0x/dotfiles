{{- $current := dict -}}
{{- $path := joinPath .chezmoi.destDir ".config/opencode/config.json" -}}
{{- if stat $path -}}
{{- $current = include $path | fromJson -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "customapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "customapi",
      "options": {
        "baseURL": "https://dindindon.ru/v1",
        "apiKey": {{ dig "provider" "customapi" "options" "apiKey" "" $current | toJson }},
        "headers": {
          "User-Agent": "Mozilla/5.0"
        }
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 SOL",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  }
}
